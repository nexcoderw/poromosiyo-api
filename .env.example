# Poromosiyo API local environment.
# Copy to .env and replace placeholders.
# Never commit the real .env file.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Customer app and admin app.
FRONTEND_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:4001

# Use the same runtime Poromosiyo database configured by ../db.
DATABASE_URL="mysql://poromosiyo_dev:change-me@127.0.0.1:3306/poromosiyo"
DATABASE_CONNECTION_LIMIT=5
DATABASE_CONNECT_ON_INIT=true

# JWT access-token secret.
# Generate locally with:
# openssl rand -base64 48
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters

# 15 minutes.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# 30 days.
# Refresh tokens will be opaque random tokens whose hashes are persisted.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Google authentication is intentionally not active during Milestone 6.
# These settings reserve the configuration contract for the later Google-auth milestone.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
