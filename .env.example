NODE_ENV=development
HOST=127.0.0.1
PORT=3000

FRONTEND_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:4001

DATABASE_URL="mysql://poromosiyo_dev:change-me@127.0.0.1:3306/poromosiyo"
DATABASE_CONNECTION_LIMIT=5
DATABASE_CONNECT_ON_INIT=true

AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters

AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_ACCOUNT_LOCK_SECONDS=900

# 24 hours.
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400

# 1 hour.
AUTH_PASSWORD_RESET_TTL_SECONDS=3600

# Per-account resend/reset email cooldown.
AUTH_EMAIL_ACTION_COOLDOWN_SECONDS=60

# Helps reduce password-reset account-enumeration timing differences.
AUTH_RECOVERY_MIN_RESPONSE_MS=500

CUSTOMER_APP_URL=http://localhost:4000
ADMIN_APP_URL=http://localhost:4001

# Development default.
# Tests always use in-memory delivery and never print tokens.
# Staging/production must use smtp.
MAIL_DELIVERY_MODE=memory

MAIL_FROM="Poromosiyo <no-reply@poromosiyo.local>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Reserved for Google authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
