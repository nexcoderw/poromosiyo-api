NODE_ENV=development
HOST=127.0.0.1
PORT=3000

FRONTEND_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:4001

DATABASE_URL="mysql://poromosiyo_dev:change-me@127.0.0.1:3306/poromosiyo"
DATABASE_CONNECTION_LIMIT=5
DATABASE_CONNECT_ON_INIT=true

AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters

AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_ACCOUNT_LOCK_SECONDS=900

AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
AUTH_EMAIL_ACTION_COOLDOWN_SECONDS=60
AUTH_RECOVERY_MIN_RESPONSE_MS=500

CUSTOMER_APP_URL=http://localhost:4000
ADMIN_APP_URL=http://localhost:4001

MAIL_DELIVERY_MODE=memory
MAIL_FROM="Poromosiyo <no-reply@poromosiyo.local>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Enable after creating a Google OAuth Web client.
GOOGLE_AUTH_ENABLED=false

# Google OAuth 2.0 Web client ID.
# The same client ID is used by Google Identity Services in the frontend
# and as the expected audience when the API verifies Google ID tokens.
GOOGLE_CLIENT_ID=


# Initial SUPERADMIN seed
#
# Copy these values into the local .env file.
# Never commit the real values.
#
# The seed command hashes SUPERADMIN_PASSWORD with Argon2id before storing it.
SUPERADMIN_FULL_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
